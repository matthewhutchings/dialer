# OCD - Open Cold Dialer Environment
# Copy this file and fill in the values

# Twenty CRM (server-side data access; all records are read/written with this key)
TWENTY_BASE_URL=https://twenty.inferencesaver.com
TWENTY_API_KEY=your-twenty-api-key-here

# Twenty OAuth (login; Twenty is the identity provider)
# Register a client pointing its redirect URI at the SPA callback,
# e.g. http://localhost:5173/callback. RFC 7591 dynamic registration works on
# self-hosted instances (POST {baseUrl}/oauth/register); a public PKCE-only
# client needs no secret, so TWENTY_OAUTH_CLIENT_SECRET may stay unset.
TWENTY_OAUTH_CLIENT_ID=your-registered-client-id
TWENTY_OAUTH_CLIENT_SECRET=
TWENTY_OAUTH_REDIRECT_URI=http://localhost:5173/callback
# "api profile" — `profile` yields the member record, `api` scopes the token
TWENTY_OAUTH_SCOPE=api profile

# If an auth-guard nginx (or similar) fronts the instance with HTTP basic auth,
# set both: the browser gets a native prompt on /authorize, and the backend
# injects the same header for discovery/token/introspection calls.
TWENTY_BASIC_USER=
TWENTY_BASIC_PASSWORD=

# Sync settings
SYNC_POLL_INTERVAL_MS=30000

# Backend
PORT=4000
JWT_SECRET=your-jwt-secret-here

# Telnyx (voice/SMS and single-pass Whisper recording transcription).
# Required on both backend and webhook deployments; never prefix with VITE_.
# Apply bun run twenty:schema before enabling the recording-ready workflow.
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_MESSAGING_PROFILE_ID=

# Dock music player (SoundCloud search + streams). A RapidAPI key subscribed
# to "SoundCloud API" (soundcloud-api3). Leave empty to turn music off.
RAPID_API_KEY=
# Shared secret gating the Telnyx webhook (?token=). Set the same value in
# the Telnyx connection webhook URL:
#   https://<backend-public-url>/api/webhooks/telnyx?token=<value>
TELNYX_WEBHOOK_TOKEN=your-webhook-token-here
# Phone audio (Settings -> Audio Source: "Call me" / "Dial in").
# A Telnyx Call Control application whose webhook URL is
#   https://<backend>/api/webhooks/telnyx?token=<TELNYX_WEBHOOK_TOKEN>
# and, for Dial in, a Telnyx number assigned to that application.
# Leave empty to offer computer audio only. Run setup-audio-sessions.ts once.
TELNYX_CALL_CONTROL_APP_ID=
# Optional AI discovery calling. Keep disabled until schema, tools and internal tests pass.
# Provision with bun run ai:voice:setup --apply; the CLI never places calls.
AI_VOICE_ENABLED=false
AI_VOICE_PUBLIC_URL=
AI_VOICE_SECRET=
AI_VOICE_TEST_NUMBERS=
# Independent 32+ character secret shared with the GitHub Actions scheduler, never sent to the browser.
AI_AUTOMATION_CRON_SECRET=
TELNYX_AI_ASSISTANT_ID=
# Separate AI-first inbound reception; provision with ai:voice:setup --inbound --apply.
AI_VOICE_INBOUND_ENABLED=false
TELNYX_INBOUND_AI_ASSISTANT_ID=
# Optional model override; unset uses Telnyx's default. Voice must be available in your account.
TELNYX_AI_MODEL=
TELNYX_AI_VOICE=Telnyx.KokoroTTS.af_heart
TELNYX_DIAL_IN_NUMBER=
# Optional inbound failover: assign TELNYX_INBOUND_NUMBER to the same Call
# Control app. TELNYX_AGENT_SIP_URI must match VITE_SIP_URI; the fallback
# mobile is called only when no browser SIP registration heartbeat is active.
# With AI_VOICE_INBOUND_ENABLED=true, AI answers first and the mobile is used
# only for caller-requested, screened handoff during UK business hours.
TELNYX_INBOUND_NUMBER=
TELNYX_AGENT_SIP_URI=
TELNYX_FALLBACK_PHONE=
# Public HTTPS URL served by the frontend deployment. Set the hostname for
# your deployment; the MP3 is frontend/public/holding-for-guidance.mp3.
TELNYX_HOLD_AUDIO_URL=

# Single canonical agency number. All dialing derives from the matching
# agencyPhones row (GET /api/twenty/phones/primary); no hardcoded caller id,
# no per-call pool picks. E.164, e.g. +12724470148. Empty = first ACTIVE row.
AGENCY_PHONE_NUMBER=

# AI call analysis (single OpenAI-compatible key). Used by
# POST /api/calls/:id/analyze and both Telnyx webhook receivers to write
# aiSummary/aiSentiment/aiScore back onto the same agencyCalls row.
# Explicitly agreed follow-ups become native Twenty tasks, assigned to the
# call owner and linked to the call and contact. The Twenty API key needs
# read/write access to tasks and taskTargets as well as agencyCalls.
# Task briefs use short controlled-English instructions, transcript evidence,
# confirmed recipient details and completion checks for future AI execution.
# The task does not authorize an agent to send messages without approval.
OPENAI_API_KEY=
# Any OpenAI-compatible gateway works. These defaults are Agnes; key/base
# URL come from the open-typesafe-camoufox WRITER_* values.
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
OPENAI_ANALYSIS_MODEL=agnes-3.0-flash

# Stale claim reap (minutes). A non-IDLE claim older than this with no
# claimedAt/lastHeartbeatAt activity may be taken/released by another member.
CLAIM_STALE_AFTER_MINUTES=60

# Browser SIP transport (Vite build-time; the voice path, not the data path)
VITE_SIP_URI=
VITE_SIP_PASSWORD=
VITE_SIP_WS_URL=wss://sip.telnyx.com:7443
VITE_SIP_CALLER_ID=
VITE_SIP_PROVIDER=telnyx
